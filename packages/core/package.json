{
  "name": "@pkpayplus/core",
  "version": "1.0.0",
  "description": "Core universal engine and primitives for PKPay+ SDKs",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "author": "PKPay+",
  "license": "MIT",
  "keywords": [
    "pkpayplus",
    "pkpay",
    "payment-gateway",
    "payments",
    "checkout",
    "sdk",
    "http-client",
    "iframe-dialog"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pkpayplus-com/pkpayplus-js.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/pkpayplus-com/pkpayplus-js#readme",
  "bugs": {
    "url": "https://github.com/pkpayplus-com/pkpayplus-js/issues"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
